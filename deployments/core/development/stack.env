# -----------------------------------------------------
# Deployment
# -----------------------------------------------------
THIS=$(realpath "$BASH_SOURCE")
HERE=$(dirname "$THIS")

export ENVIRONMENT_BASE=$(dirname "$THIS")
DEPLOYMENT_BASE=$(dirname "$ENVIRONMENT_BASE")

export ENVIRONMENT=$(basename "$ENVIRONMENT_BASE")
export DEPLOYMENT=$(basename "$DEPLOYMENT_BASE")

export CONFIGS="${ENVIRONMENT_BASE}/configs"
export SECRETS="${ENVIRONMENT_BASE}/secrets"

export STACK_PATH=$(realpath "$HERE/../../../")
export STACK_BASE=$(basename "$STACK_PATH" | sed 's/^stack\-//')
export STACK="${STACK_BASE}_${DEPLOYMENT}"

export CONTEXT="${ENVIRONMENT}.${DEPLOYMENT}"

# -----------------------------------------------------
# Docker
# -----------------------------------------------------
# Authelia
AUTHELIA_VERSION="4.39.28"
export AUTHELIA_IMAGE="authelia/authelia:${AUTHELIA_VERSION}"

# -----------------------------------------------------
# Configuration
# -----------------------------------------------------
# LLDAP from stack-lldap. Authelia binds as this user, in lldap_strict_readonly, its password
# is AUTHELIA_LDAP_PASSWORD in secrets.env.
export AUTHELIA_LDAP_ADDRESS="ldap://lldap.lldap-core.svc.cluster.local:3890"
export AUTHELIA_LDAP_USER="authelia"

# Where the portal sends people after logging in, when they didn't come from another site.
export AUTHELIA_DEFAULT_REDIRECT="homepage"

# The data (SQLite storage and the notifier's file) is kept on this StorageClass, Longhorn
# from stack-longhorn. The volume can't be moved to another StorageClass without recreating it.
export AUTHELIA_STORAGE_CLASS="longhorn"
export AUTHELIA_VOLUME_SIZE="1Gi"
